      "cell_type": "code",
      "source": [
        "# --- COMPARATIVA SHAP: 500 vs 50,000 DATOS (Página 8) ---\n",
        "import shap\n",
        "\n",
        "# Función rápida para crear y entrenar el modelo según los datos deseados\n",
        "def entrenar_modelo_comparativo(n_datos, n_epochs=6):\n",
        "    # Misma arquitectura que definiste antes\n",
        "    m = tf.keras.Sequential([\n",
        "        tf.keras.layers.Flatten(input_shape=(28, 28, 1)),\n",
        "        tf.keras.layers.Dense(32, activation='relu'),\n",
        "        tf.keras.layers.Dense(10, activation='softmax')\n",
        "    ])\n",
        "    m.compile(optimizer='adam', loss='sparse_categorical_crossentropy', metrics=['accuracy'])\n",
        "    m.fit(x_train_exp[:n_datos], y_train[:n_datos], epochs=n_epochs, verbose=0)\n",
        "    return m\n",
        "\n",
        "print(\"Entrenando modelos para la comparativa\")\n",
        "model_500 = entrenar_modelo_comparativo(500)\n",
        "model_50000 = entrenar_modelo_comparativo(50000)\n",
        "\n",
        "# SHAP para el modelo de 500 datos\n",
        "print(\"\\n--- SHAP: Modelo con 500 datos ---\")\n",
        "explainer_500 = shap.DeepExplainer(model_500, x_train_exp[:100])\n",
        "shap_values_500 = explainer_500.shap_values(x_test_exp[0:1])\n",
        "shap.image_plot(shap_values_500, x_test_exp[0:1])\n",
        "\n",
        "# SHAP para el modelo de 50,000 datos\n",
        "print(\"\\n--- SHAP: Modelo con 50,000 datos ---\")\n",
        "explainer_50000 = shap.DeepExplainer(model_50000, x_train_exp[:100])\n",
        "shap_values_50000 = explainer_50000.shap_values(x_test_exp[0:1])\n",
        "shap.image_plot(shap_values_50000, x_test_exp[0:1])"
      ],
      "metadata": {
